{
  "$defs": {
    "diagnostic": {
      "additionalProperties": false,
      "properties": {
        "anchor_line": {
          "type": "integer"
        },
        "expect_status": {
          "enum": [
            "deleted_test",
            "fulfilled",
            "none",
            "unfulfilled"
          ],
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^v1:[0-9a-f]{40}$",
          "type": "string"
        },
        "level": {
          "enum": [
            "allow",
            "deny",
            "forbid",
            "warn"
          ],
          "type": "string"
        },
        "message": {
          "description": "Unstable in 0.1.0.",
          "type": "string"
        },
        "origin": {
          "enum": [
            "agentrulelint",
            "preset",
            "project"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "span": {
          "additionalProperties": false,
          "properties": {
            "end_col": {
              "type": "integer"
            },
            "end_line": {
              "type": "integer"
            },
            "start_col": {
              "type": "integer"
            },
            "start_line": {
              "type": "integer"
            }
          },
          "required": [
            "end_col",
            "end_line",
            "start_col",
            "start_line"
          ],
          "type": "object"
        },
        "suppressed": {
          "type": "boolean"
        },
        "type": {
          "const": "diagnostic",
          "type": "string"
        }
      },
      "required": [
        "anchor_line",
        "expect_status",
        "fingerprint",
        "level",
        "message",
        "origin",
        "path",
        "rule_id",
        "span",
        "suppressed",
        "type"
      ],
      "type": "object"
    },
    "header": {
      "additionalProperties": false,
      "properties": {
        "config_source": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "builtin",
                "git_ref",
                "path"
              ],
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "git_executable": {
          "type": "string"
        },
        "git_version": {
          "type": "string"
        },
        "julia_version": {
          "type": "string"
        },
        "parser": {
          "description": "Unstable in 0.1.0.",
          "type": "string"
        },
        "position_encoding": {
          "const": "utf8-codepoint-1based",
          "type": "string"
        },
        "type": {
          "const": "header",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "config_source",
        "git_executable",
        "git_version",
        "julia_version",
        "parser",
        "position_encoding",
        "type",
        "version"
      ],
      "type": "object"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "exit_code": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "rules": {
          "type": "integer"
        },
        "suppressed": {
          "type": "integer"
        },
        "threshold": {
          "enum": [
            "allow",
            "deny",
            "forbid",
            "warn"
          ],
          "type": "string"
        },
        "threshold_source": {
          "enum": [
            "cli",
            "config",
            "default"
          ],
          "type": "string"
        },
        "type": {
          "const": "summary",
          "type": "string"
        },
        "violations": {
          "type": "integer"
        }
      },
      "required": [
        "complete",
        "exit_code",
        "rules",
        "suppressed",
        "threshold",
        "threshold_source",
        "type",
        "violations"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/yamanori99/AgentRuleLint.jl/schemas/check-jsonl.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One JSON object per line from `agentrulelint check --format=json`. Fields marked unstable may change in 0.1.0-DEV without a major bump.",
  "items": {
    "oneOf": [
      {
        "$ref": "#/$defs/header"
      },
      {
        "$ref": "#/$defs/diagnostic"
      },
      {
        "$ref": "#/$defs/summary"
      }
    ]
  },
  "title": "AgentRuleLint check JSONL",
  "type": "array"
}
